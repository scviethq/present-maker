{
  "name": "present-maker",
  "version": "0.1.0",
  "description": "Turn Markdown decks with scene blocks into isometric 3D step-through presentations",
  "type": "module",
  "bin": {
    "present-maker": "./bin/present-maker.js"
  },
  "scripts": {
    "build:runtime": "vite build --config src/runtime/vite.config.ts",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build": "npm run build:runtime && npm run build:cli",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "elkjs": "^0.12.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide": "^1.76.0",
    "markdown-it": "^15.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "playwright": "^1.65.1",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.12"
  }
}
